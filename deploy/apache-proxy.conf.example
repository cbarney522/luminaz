# Apache settings that hand a website's requests to Luminaz (gunicorn on 127.0.0.1:8000).
# TESTED 7 November 2026 on InterWorx 8 / AlmaLinux 8, as /home/newmoney/var/newmoneystrategy.com/apache/luminaz.conf
# (see DEPLOY-SERVER.md, step 5). Needs mod_rewrite, mod_proxy, mod_proxy_http and mod_headers.

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

ProxyPreserveHost On
RequestHeader set X-Forwarded-Proto "https"
ProxyPass /.well-known !
ProxyPass / http://127.0.0.1:8000/
ProxyPassReverse / http://127.0.0.1:8000/

# Private until Diane and the attorney open the site: everything asks for a login first.
# Create the logins with: htpasswd -c /etc/luminaz/htpasswd NAME   (then chgrp apache, chmod 640)
# TO OPEN THE SITE TO THE PUBLIC: delete this <Location /> block, then: httpd -t && systemctl reload httpd
<Location />
    AuthType Basic
    AuthName "Luminaz (private)"
    AuthUserFile /etc/luminaz/htpasswd
    Require valid-user
</Location>
<Location /.well-known/>
    Require all granted
</Location>
